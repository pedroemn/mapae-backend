# Copie este arquivo para .env (fora do git) e preencha a senha.
# Sem .env, a aplicacao usa o banco local do compose.yaml (AD-020).
# A senha do banco nao e a chave da API (sb_publishable_...). Use so letras e numeros:
# o .env e lido como .properties, que altera caracteres como a barra invertida.
MAPAE_DB_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
MAPAE_DB_USUARIO=postgres.ksyqlcayrgksoowrfofl
MAPAE_DB_SENHA=<senha-do-banco>

# Segredo do JWT (AD-004): pelo menos 32 letras e numeros, diferente em cada ambiente.
MAPAE_JWT_SEGREDO=<segredo-com-32-ou-mais-caracteres>
# Validade do token (opcional, padrao 24h)
# MAPAE_JWT_VALIDADE=24h

# Origens do front web liberadas no CORS, separadas por virgula (opcional,
# padrao http://localhost:3000,http://localhost:5173). Sem barra no final.
# MAPAE_CORS_ORIGENS=http://localhost:5173,https://app.mapae.com.br

# Cloudflare R2 (armazenamento de midias). Obrigatorias: sem elas a aplicacao nao sobe.
# Os nomes sao os que R2Config e R2Service leem. Sem conta R2, valores falsos bastam
# para subir local, mas o upload falha.
CLOUDFLARE_ACCOUNT_ID=<account-id>
CLOUDFLARE_ACCESS_KEY_ID=<access-key-id>
CLOUDFLARE_SECRET_ACCESS_KEY=<secret-access-key>
CLOUDFLARE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=mapae-midias
# CLOUDFLARE_R2_PUBLIC_URL=https://midias.mapae.com.br
